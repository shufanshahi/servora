# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Matches backend/docker-compose.yml (database published on host port 5433)
DATABASE_URL=postgres://servora:servora@localhost:5433/servora
# Comma-separated browser origins allowed by CORS (the mobile app does not need this)
CORS_ORIGINS=http://localhost:3000
# Secret used to sign login tokens: REQUIRED, at least 32 random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The value below is a placeholder for local development only. Never reuse it anywhere real.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
# Login token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_IN_SECONDS=604800
# bcrypt cost factor for password hashing (default 12)
BCRYPT_COST=12
# Register/login attempts allowed per client IP per window (defaults: 10 per 900 s)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Used to build absolute URLs such as service image links
PUBLIC_BASE_URL=http://localhost:3000
# Separate database used only by the test suite (created automatically; name must contain "test")
TEST_DATABASE_URL=postgres://servora:servora@localhost:5433/servora_test
